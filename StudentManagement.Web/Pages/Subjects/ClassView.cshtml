@page "{subjectId:int}/{gradeLevel}/{section}"
@model StudentManagement.Web.Pages.Subjects.ClassViewModel
@{
    ViewData["Title"] = "Class Records";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>@Model.Subject.Name</h2>
            <h5 class="text-muted">@Model.GradeLevel — Section @Model.Section</h5>
        </div>
        <a asp-page="Details" asp-route-id="@Model.Subject.Id" class="btn btn-secondary">
            &larr; Back to Sections
        </a>
    </div>

    <!-- Assigned Teacher Information Card -->
    <div class="card mb-4 shadow-sm border-info">
        <div class="card-body d-flex align-items-center">
            <i class="bi bi-person-badge fs-1 me-3 text-info"></i>
            <div>
                <span class="text-muted small uppercase">Assigned Teacher</span>
                <h4 class="mb-0 text-dark">
                    @(Model.Teacher?.FullName ?? "No Teacher Assigned")
                </h4>
            </div>
        </div>
    </div>

    <!-- Editable Student Marks & Absences Table -->
    <form method="post" 
          asp-page-handler="SaveRecords" 
          asp-route-subjectId="@Model.Subject.Id" 
          asp-route-gradeLevel="@Model.GradeLevel" 
          asp-route-section="@Model.Section">

        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Student Roster (@Model.Students.Count Students)</h5>
                @if (Model.Students.Any())
                {
                    <button type="submit" class="btn btn-success fw-bold">
                        Save Grades & Absences
                    </button>
                }
            </div>
            <div class="card-body">
                @if (Model.Students.Any())
                {
                    <table class="table table-bordered table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th style="width: 180px;">Absences</th>
                                <th style="width: 200px;">Mark (Out of 100)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Model.Students[i].StudentId
                                        <input type="hidden" asp-for="Students[i].StudentId" />
                                        <input type="hidden" asp-for="Students[i].FullName" />
                                    </td>
                                    <td><strong>@Model.Students[i].FullName</strong></td>
                                    <td>
                                        <input type="number" 
                                               min="0" 
                                               asp-for="Students[i].Absences" 
                                               class="form-control" />
                                    </td>
                                    <td>
                                        <input type="number" 
                                               min="0" 
                                               max="100" 
                                               asp-for="Students[i].Mark" 
                                               class="form-control" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">No students found in @Model.GradeLevel — Section @Model.Section.</p>
                }
            </div>
        </div>
    </form>
</div>