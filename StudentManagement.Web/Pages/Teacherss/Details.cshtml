@page "{id:int}"
@model StudentManagement.Web.Pages.Teacherss.DetailsModel
@{
    ViewData["Title"] = "Teacher Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">Teacher Details</h2>
        <div>
            <a asp-page="./Edit" asp-route-id="@Model.Teacher?.Id" class="btn btn-primary rounded-2 px-3">Edit</a>
            <a asp-page="./Index" class="btn btn-outline-secondary rounded-2 px-3">Back to List</a>
        </div>
    </div>

    @if (Model.Teacher != null)
    {
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="fw-bold text-muted small">FULL NAME</label>
                    <p class="fs-5 text-dark mb-0">@Model.Teacher.FullName</p>
                </div>
                <div class="col-md-6">
                    <label class="fw-bold text-muted small">EMAIL</label>
                    <p class="fs-5 text-dark mb-0">@Model.Teacher.Email</p>
                </div>
                <div class="col-md-6">
                    <label class="fw-bold text-muted small">SUBJECT</label>
                    <p class="fs-5 text-dark mb-0">
                        @(Model.Teacher.Subject?.Name ?? "General")
                    </p>
                </div>
                <div class="col-md-6">
                    <label class="fw-bold text-muted small">GRADE LEVEL / SECTION</label>
                    <p class="fs-5 text-dark mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Teacher.GradeLevel) ? "N/A" : Model.Teacher.GradeLevel)
                        @(string.IsNullOrWhiteSpace(Model.Teacher.Section) ? "" : $" ({Model.Teacher.Section})")
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger shadow-sm rounded-3">Teacher record not found.</div>
    }
</div>