@page
@model StudentManagement.Web.Pages.Teacherss.CreateModel
@{
    ViewData["Title"] = "Add Teacher";
}

<div class="container mt-4">
    <h2>Add New Teacher</h2>

    <form method="post" class="mt-3">
        <!-- Teacher Basic Info -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Teacher Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input asp-for="Teacher.FullName" class="form-control" required placeholder="e.g. John Doe" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Teacher.Email" type="email" class="form-control" required placeholder="e.g. teacher@school.com" />
                </div>
            </div>
        </div>

        <!-- Multiple Class Assignments Section -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Class & Subject Assignments</h5>
                <button type="button" class="btn btn-sm btn-outline-primary" id="addAssignmentBtn">
                    <i class="bi bi-plus-circle"></i> + Add Class Row
                </button>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">You can assign multiple subjects, grades, and sections to this teacher.</p>

                <div id="assignmentsContainer">
                    <!-- Default initial assignment row -->
                    <div class="row g-3 mb-3 assignment-row align-items-end">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Subject</label>
                            <select name="Assignments[0].SubjectId" class="form-select">
                                <option value="">-- Select Subject --</option>
                                @foreach (var item in Model.SubjectList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Grade Level</label>
                            <select name="Assignments[0].GradeLevel" class="form-select">
                                <option value="">-- Select Grade --</option>
                                <option value="Kindergarten">Kindergarten</option>
                                <option value="1st Grade">1st Grade</option>
                                <option value="2nd Grade">2nd Grade</option>
                                <option value="3rd Grade">3rd Grade</option>
                                <option value="4th Grade">4th Grade</option>
                                <option value="5th Grade">5th Grade</option>
                                <option value="6th Grade">6th Grade</option>
                                <option value="7th Grade">7th Grade</option>
                                <option value="8th Grade">8th Grade</option>
                                <option value="9th Grade">9th Grade</option>
                                <option value="10th Grade">10th Grade</option>
                                <option value="11th Grade">11th Grade</option>
                                <option value="12th Grade">12th Grade</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Section</label>
                            <select name="Assignments[0].Section" class="form-select">
                                <option value="">-- Select Section --</option>
                                <option value="A">Section A</option>
                                <option value="B">Section B</option>
                                <option value="C">Section C</option>
                                <option value="D">Section D</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-outline-danger w-100 remove-row-btn" disabled>
                                Remove
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save Teacher</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        let rowIndex = 1;

        document.getElementById('addAssignmentBtn').addEventListener('click', function () {
            const container = document.getElementById('assignmentsContainer');
            const firstRow = container.querySelector('.assignment-row');
            const newRow = firstRow.cloneNode(true);

            newRow.querySelectorAll('select').forEach(select => {
                select.name = select.name.replace(/\[\d+\]/, `[${rowIndex}]`);
                select.value = '';
            });

            const removeBtn = newRow.querySelector('.remove-row-btn');
            removeBtn.removeAttribute('disabled');
            removeBtn.addEventListener('click', function () {
                newRow.remove();
            });

            container.appendChild(newRow);
            rowIndex++;
        });
    </script>
}