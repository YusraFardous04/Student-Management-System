@page
@model StudentManagement.Web.Pages.Students.CreateModel
@{
    ViewData["Title"] = "Add Student";
}

<div class="container mt-4">
    <h2>Add New Student</h2>

    <form method="post" class="mt-3">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Student Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Student.FullName" class="form-label fw-bold">Full Name</label>
                    <input asp-for="Student.FullName" class="form-control" required placeholder="e.g. Jane Doe" />
                    <span asp-validation-for="Student.FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Student.Email" class="form-label fw-bold">Email</label>
                    <input asp-for="Student.Email" type="email" class="form-control" required placeholder="e.g. student@school.com" />
                    <span asp-validation-for="Student.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Student.PhoneNumber" class="form-label fw-bold">Phone Number</label>
                    <input asp-for="Student.PhoneNumber" class="form-control" placeholder="e.g. +123456789" />
                    <span asp-validation-for="Student.PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Student.DateOfBirth" class="form-label fw-bold">Date of Birth</label>
                    <input asp-for="Student.DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="Student.DateOfBirth" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Student.GradeLevel" class="form-label fw-bold">Grade Level</label>
                        <select asp-for="Student.GradeLevel" class="form-select" required>
                            <option value="">-- Select Grade --</option>
                            @foreach (var grade in Model.GradeOptions)
                            {
                                <option value="@grade">@grade</option>
                            }
                        </select>
                        <span asp-validation-for="Student.GradeLevel" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Student.Section" class="form-label fw-bold">Section</label>
                        <select asp-for="Student.Section" class="form-select" required>
                            <option value="">-- Select Section --</option>
                            @foreach (var sec in Model.SectionOptions)
                            {
                                <option value="@sec">Section @sec</option>
                            }
                        </select>
                        <span asp-validation-for="Student.Section" class="text-danger"></span>
                    </div>
                </div>

                <!-- Enrolled Subjects Checkboxes -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Enrolled Subjects</label>
                    @if (Model.AvailableSubjects != null && Model.AvailableSubjects.Any())
                    {
                        <div class="row">
                            @foreach (var subject in Model.AvailableSubjects)
                            {
                                <div class="col-md-4 col-sm-6 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="Student.EnrolledSubjectIds"
                                               value="@subject.Id"
                                               id="subject_@subject.Id"
                                        @(Model.Student.EnrolledSubjectIds.Contains(subject.Id) ? "checked" : "") />
                                        <label class="form-check-label" for="subject_@subject.Id">
                                            @subject.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No subjects available in the system yet.</p>
                    }
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save Student</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}