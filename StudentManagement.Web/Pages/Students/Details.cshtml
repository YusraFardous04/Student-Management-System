@page "{id:int}"
@model StudentManagement.Web.Pages.Students.DetailsModel
@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Student Details</h2>
        <div>
            <a asp-page="Edit" asp-route-id="@Model.Student.Id" class="btn btn-primary">Edit</a>
            <a asp-page="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>

    <!-- Personal Info -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Personal & Class Info</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.Student.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Student.Email</dd>

                <dt class="col-sm-3">Date of Birth</dt>
                <dd class="col-sm-9">@(Model.Student.DateOfBirth.HasValue ? Model.Student.DateOfBirth.Value.ToString("yyyy-MM-dd") : "N/A")</dd>

                <dt class="col-sm-3">Grade Level</dt>
                <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Student.GradeLevel</span></dd>

                <dt class="col-sm-3">Section</dt>
                <dd class="col-sm-9"><span class="badge bg-info text-dark">Section @Model.Student.Section</span></dd>
            </dl>
        </div>
    </div>

    <!-- Enrolled Checked Subjects & Assigned Teachers -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Enrolled Subjects & Teachers</h5>
        </div>
        <div class="card-body">
            @if (Model.EnrolledSubjectsWithTeachers != null && Model.EnrolledSubjectsWithTeachers.Any())
            {
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Teacher Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.EnrolledSubjectsWithTeachers)
                        {
                            <tr>
                                <td><strong>@item.Subject.Name</strong></td>
                                <td>
                                    <i class="bi bi-person-badge me-1"></i>
                                    @item.TeacherName
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0">
                    No enrolled subjects selected for <strong>@Model.Student.FullName</strong>.
                </p>
            }
        </div>
    </div>
</div>