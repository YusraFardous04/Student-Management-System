@page "{id:int}"
@model StudentManagement.Web.Pages.Students.EnrollmentModel
<div class="container mt-4">
    <h1>Enrollment — @Model.Student?.FullName</h1>

    <h3 class="mt-4">Currently Enrolled (@Model.Enrollments.Count / 10)</h3>
    <table class="table table-striped">
        <thead><tr><th>Subject</th><th></th></tr></thead>
        <tbody>
            @foreach (var enrollment in Model.Enrollments)
            {
                <tr>
                    <td>@enrollment.Subject?.Name</td>
                    <td>
                        <form method="post" asp-page-handler="Unenroll" asp-route-id="@Model.Student!.Id" asp-route-enrollmentId="@enrollment.Id" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <h3 class="mt-4">Enroll in Subjects</h3>
    <form method="post" asp-page-handler="Enroll" asp-route-id="@Model.Student!.Id">
        @for (int i = 0; i < Model.SubjectOptions.Count; i++)
        {
            <div class="form-check">
                <input type="hidden" asp-for="SubjectOptions[i].SubjectId" />
                <input type="hidden" asp-for="SubjectOptions[i].Name" />
                <input type="checkbox" class="form-check-input" asp-for="SubjectOptions[i].IsSelected" />
                <label class="form-check-label" asp-for="SubjectOptions[i].IsSelected">
                    @Model.SubjectOptions[i].Name
                </label>
            </div>
        }
        <button type="submit" class="btn btn-primary mt-2">Enroll in Selected</button>
    </form>

    <a asp-page="Details" asp-route-id="@Model.Student!.Id" class="btn btn-secondary mt-3">Back to Student</a>
</div>