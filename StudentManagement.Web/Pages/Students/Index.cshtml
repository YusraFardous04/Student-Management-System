@page
@model StudentManagement.Web.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">
    <!-- Header with Title & Add Student Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">Students</h2>
        <a asp-page="./Create" class="btn btn-success rounded-2 px-3">
            + Add Student
        </a>
    </div>

    <!-- Search Bar -->
    <form method="get" class="mb-4">
        <div class="input-group shadow-sm rounded-3 overflow-hidden">
            <input type="text" 
                   asp-for="Search" 
                   class="form-control border-0 px-3 py-2" 
                   placeholder="Search student..." />
            <button type="submit" class="btn btn-primary px-4">Search</button>
            <a asp-page="./Index" class="btn btn-outline-secondary px-3">Clear</a>
        </div>
    </form>

    <!-- Cards List -->
    @if (Model.Students != null && Model.Students.Any())
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var student in Model.Students)
            {
                <div class="card border-0 shadow-sm rounded-3 p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-semibold text-dark mb-1">@student.FullName</h5>
                            <span class="badge bg-light text-secondary border fw-normal">
                                @student.GradeLevel — Section @student.Section
                            </span>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-page="./Details" asp-route-id="@student.Id" class="btn btn-sm btn-info text-white rounded-2 px-3">Details</a>
                            <a asp-page="./Edit" asp-route-id="@student.Id" class="btn btn-sm btn-primary rounded-2 px-3">Edit</a>
                            
                            <form method="post" asp-page-handler="Delete" asp-route-id="@student.Id" onsubmit="return confirm('Are you sure you want to delete this student?');">
                                <button type="submit" class="btn btn-sm btn-danger rounded-2 px-3">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border shadow-sm rounded-3 mb-0">No students found.</div>
    }
</div>