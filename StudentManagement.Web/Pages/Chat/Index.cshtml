@page
@model StudentManagement.Web.Pages.Chat.IndexModel

<div class="chat-wrapper">
    <div class="chat-header">
        <div class="chat-header-title">School Assistant</div>
        <form method="post" asp-page-handler="Reindex">
            <button type="submit" class="btn btn-sm btn-outline-light">Rebuild Knowledge Base</button>
        </form>
    </div>

    <div class="chat-messages" id="chatMessages">
        @foreach (var turn in Model.Conversation)
        {
            var isUser = turn.Role == "user";
            <div class="chat-bubble @(isUser ? "chat-bubble-user" : "chat-bubble-bot")">@turn.Text</div>
        }
    </div>

    <form method="post" asp-page-handler="Ask" class="chat-input-row">
        <input type="hidden" name="History" value="@ChatTurn.ToHiddenField(Model.Conversation)" />
        <input type="hidden" asp-for="SessionId" />

        <textarea asp-for="Question" class="chat-input" rows="1"
                  placeholder="Type your question…"></textarea>

        <button type="submit" class="chat-send-btn">Send</button>
    </form>
</div>

<style>
    .chat-wrapper {
        max-width: 800px;
        margin: 24px auto;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 140px);
        border: 1px solid #e3e6ea;
        border-radius: 12px;
        overflow: hidden;
        background: #f7f8fa;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }

    .chat-header {
        background: #0d6efd;
        color: #fff;
        padding: 14px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header-title {
        font-weight: 600;
        font-size: 1.05rem;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .chat-bubble {
        max-width: 75%;
        padding: 10px 14px;
        border-radius: 16px;
        line-height: 1.45;
        font-size: 0.95rem;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .chat-bubble-user {
        align-self: flex-end;
        background: #0d6efd;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .chat-bubble-bot {
        align-self: flex-start;
        background: #fff;
        color: #1c1e21;
        border: 1px solid #e3e6ea;
        border-bottom-left-radius: 4px;
    }

    .chat-input-row {
        display: flex;
        gap: 8px;
        padding: 12px;
        background: #fff;
        border-top: 1px solid #e3e6ea;
    }

    .chat-input {
        flex: 1;
        resize: none;
        border: 1px solid #d6dade;
        border-radius: 20px;
        padding: 10px 16px;
        font-size: 0.95rem;
        outline: none;
        max-height: 120px;
        font-family: inherit;
    }

        .chat-input:focus {
            border-color: #0d6efd;
        }

    .chat-send-btn {
        background: #0d6efd;
        color: #fff;
        border: none;
        border-radius: 20px;
        padding: 0 22px;
        font-weight: 500;
        cursor: pointer;
    }

        .chat-send-btn:hover {
            background: #0b5ed7;
        }
</style>

<script>
    // Auto-scroll to the newest message on load
    (function () {
        var box = document.getElementById('chatMessages');
        if (box) box.scrollTop = box.scrollHeight;
    })();

    // Auto-grow textarea and Enter-to-send
    (function () {
        var ta = document.querySelector('.chat-input');
        if (!ta) return;

        ta.addEventListener('input', function () {
            ta.style.height = 'auto';
            ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
        });

        ta.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                ta.form.requestSubmit();
            }
        });

        ta.focus();
    })();
</script>